# Spec for the server's .env. bombur-add-app (run by bombur-onboard) copies this file ONCE to
# /home/deploy/DOCKER/gifter/.env (never overwritten afterwards) and replaces every CHANGE_ME
# with a random alphanumeric value. bombur-deploy sets IMAGE_TAG in that .env on every deploy.
# Fill the empty Google values by hand: see DEPLOYMENT.md.

# --- Managed by bombur-deploy (IMAGE_TAG is overwritten on every deploy) ---
GITHUB_REPOSITORY=ciakval/gifter
IMAGE_TAG=latest
CONTAINER_NAME=gifter-web
DEPLOY_ENV=production

# --- App settings ---
# Generated by bombur-add-app (CHANGE_ME -> random value). The app refuses to start without it.
SECRET_KEY=CHANGE_ME
DEBUG=False
PUBLIC_HOSTS=gifter.remesh.cz
# Google OAuth client (production). Left empty on purpose: the app refuses to start until
# they are filled in on the server. See DEPLOYMENT.md, "Google Cloud Console".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Start small; raise (e.g. 31536000) after a week of working HTTPS.
SECURE_HSTS_SECONDS=3600
# DATA_DIR is not set: the default (/app/data) matches the ./data bind mount.

# --- Observability (leave endpoint empty until the OTLP collector exists) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
