# Copy to .env in the deploy directory on Bombur (~/DOCKER/gifter/.env), chmod 600.
# Generate secrets with: openssl rand -base64 48
# (never Django's own key generator: its alphabet includes $, which Compose may interpolate)

# --- Managed by CI (overwritten on every deploy) ---
GITHUB_REPOSITORY=ciakval/gifter
IMAGE_TAG=latest
CONTAINER_NAME=gifter-web
DEPLOY_ENV=production

# --- App settings ---
# Left empty on purpose: the app refuses to start until this is filled in.
SECRET_KEY=
DEBUG=False
PUBLIC_HOSTS=gifter.remesh.cz
# Google OAuth client (production). See DEPLOYMENT.md, "Google Cloud Console" step.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Start small; raise (e.g. 31536000) after a week of working HTTPS.
SECURE_HSTS_SECONDS=3600
# DATA_DIR is not set: the default (/app/data) matches the ./data bind mount.

# --- Observability (leave endpoint empty until the OTLP collector exists) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
